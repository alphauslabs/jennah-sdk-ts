{
  "name": "jennah-sdk-ts",
  "version": "0.0.0-dev.0",
  "description": "TypeScript SDK for Jennah, the memory and context platform for AI agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphauslabs/jennah-sdk-ts.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gen/*": {
      "browser": "./dist/browser.js",
      "types": "./dist/gen/*.d.ts",
      "default": "./dist/gen/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && rm -rf build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-force-exit 'build/test/**/*.test.js'",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
